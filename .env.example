# Canonical site URL — used for canonicals, sitemap.xml and schema.org.
# Set this in Vercel to the production domain.
NEXT_PUBLIC_SITE_URL=https://www.mxelectric.net

# ---------------------------------------------------------------------
# Lead form delivery. Set ONE of the options below.
# With neither set, submissions are logged to the server console and the
# form still reports success (useful for local development).
# ---------------------------------------------------------------------

# Option A — Formspree (no code, quickest to set up)
# LEAD_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Option B — Resend (email delivered from your own domain)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# LEAD_TO_EMAIL=office@mxelectric.net
# LEAD_FROM_EMAIL=website@mxelectric.net
